# Public site URL (used for canonical URLs, sitemap, structured data, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.incodecraft.com

# Contact form destination (configure with your form handler, e.g. Formspree, Resend, or a serverless endpoint)
CONTACT_FORM_ENDPOINT=

# Google Analytics 4 (leave empty to disable)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (leave empty to disable)
NEXT_PUBLIC_GSC_VERIFICATION=
