# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.incodecraft.com

# --- Contact form (email) ---
# Recommended: Resend (https://resend.com) — free tier, works on Vercel
RESEND_API_KEY=
CONTACT_EMAIL_TO=dani_imbrea@yahoo.com
# After verifying incodecraft.com in Resend, switch to:
# CONTACT_EMAIL_FROM=INCODECRAFT Contact <hello@incodecraft.com>
CONTACT_EMAIL_FROM=INCODECRAFT Contact <onboarding@resend.dev>

# Alternative: forward to Formspree/Web3Forms instead of Resend
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Google Analytics 4 (leave empty to disable)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (leave empty to disable)
NEXT_PUBLIC_GSC_VERIFICATION=
